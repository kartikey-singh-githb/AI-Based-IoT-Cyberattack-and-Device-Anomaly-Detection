# ============================================================
# P_310 - AI-Based IoT Cyberattack and Device Anomaly Detection
# Backend environment configuration (example)
# Copy this file to `.env` and adjust values for your machine.
# `.env` is excluded from Git - never commit real secrets.
# ============================================================

# ---- Application ----
P310_APP_NAME=P310 IoT Anomaly Detection
P310_ENVIRONMENT=development
P310_DEBUG=true
P310_HOST=127.0.0.1
P310_PORT=8000

# ---- Database (SQLite) ----
# Relative paths are resolved from the backend/ working directory.
P310_DATABASE_URL=sqlite:///./p310.db

# ---- CORS ----
# Comma separated list of allowed origins for the React dashboard.
P310_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- MQTT broker ----
# If the broker is unreachable the app switches to the clearly labelled
# in-process FALLBACK mode (demo mode) instead of pretending to be connected.
P310_MQTT_ENABLED=true
P310_MQTT_HOST=127.0.0.1
P310_MQTT_PORT=1883
P310_MQTT_KEEPALIVE=30
P310_MQTT_CLIENT_ID=p310_backend
P310_MQTT_USERNAME=
P310_MQTT_PASSWORD=
# Seconds to wait for broker connection before entering fallback mode
P310_MQTT_CONNECT_TIMEOUT=4

# ---- MQTT topics ----
P310_MQTT_TOPIC_TELEMETRY=iot/devices
P310_MQTT_TOPIC_STATUS_SUFFIX=status
P310_MQTT_TOPIC_ALERTS=iot/security/alerts

# ---- Simulation ----
P310_SIM_DEFAULT_DEVICE_COUNT=6
P310_SIM_TICK_SECONDS=2.0
# Probability that a tick produces a labelled abnormal behaviour event
P310_SIM_ANOMALY_PROBABILITY=0.06
# Hard cap on simulated devices
P310_SIM_MAX_DEVICES=32
# Start the fleet automatically when the API boots (handy for demos; the
# built-in code default is false). Tests override this to false regardless.
P310_SIM_AUTO_START=false
# Messages emitted per injected scenario
P310_SIM_INJECT_MESSAGES=12

# ---- Machine learning (Isolation Forest) ----
P310_ML_MODEL_PATH=./app/ml/artifacts/isolation_forest.joblib
P310_ML_MODEL_CONFIG_PATH=./app/ml/artifacts/model_config.json
# Contamination expected during training (drives the IsolationForest offset)
P310_ML_CONTAMINATION=0.05
# Fraction of the training distribution flagged at inference time. The
# decision threshold and the suspicious/critical bands are calibrated from
# this quantile, which keeps alert volume predictable.
P310_ML_FLAG_QUANTILE=0.05
# Threshold on the decision score. Lower = more sensitive.
# 0.0 means "auto": calibrate from P310_ML_FLAG_QUANTILE.
P310_ML_ANOMALY_THRESHOLD=0.0
P310_ML_RANDOM_SEED=42

# ---- Feature extraction ----
# Sliding look-back window (seconds). Must match training-time value.
P310_FEATURE_WINDOW_SIZE=30
# Minimum seconds between persisted anomaly events for the same device
P310_DETECTION_COOLDOWN_S=10.0
# Rolling in-memory history length (messages) per device
P310_DETECTION_HISTORY_LEN=500

# ---- Logging ----
P310_LOG_LEVEL=INFO
P310_LOG_FILE=./logs/backend.log
